# /etc/euroflex/live.env - settings for scripts/ops/run_live.sh (see docs/deployment.md). Paper execution only.
# A changed strategy or battery needs a new EUROFLEX_RUN_DIR: a run directory resumes exactly one run.
EUROFLEX_RUN_DIR=/var/lib/euroflex/run
EUROFLEX_MODELS_DIR=/var/lib/euroflex/models
EUROFLEX_STRATEGY=threshold
EUROFLEX_POWER_MW=1
EUROFLEX_ENERGY_MWH=2
EUROFLEX_MECHANISM=auto
EUROFLEX_EXECUTION=paper
EUROFLEX_POLL_SECONDS=15
EUROFLEX_HISTORY_DAYS=14
EUROFLEX_PUBLIC_HISTORY=1
MPLCONFIGDIR=/var/lib/euroflex/.matplotlib
TZ=UTC
